# Protects /api/keep-alive and /api/status.
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-secret

# Optional tuning.
PING_TIMEOUT_MS=15000
PING_CONCURRENCY=5
MAX_INDEXED_PROJECTS=50
SUPABASE_PING_PATH=/auth/v1/health

# Add one block per Supabase project. The REF is the project ref from:
# https://<project-ref>.supabase.co
# Do not commit real anon keys in a public repo. Replace each placeholder on
# your server with the matching Supabase anon key.
SUPABASE_PROJECT_1_NAME=Main workload
SUPABASE_PROJECT_1_REF=your-project-ref
SUPABASE_PROJECT_1_ANON_KEY=replace-with-ajkertakarrate-anon-key

SUPABASE_PROJECT_2_NAME=Main workload
SUPABASE_PROJECT_2_REF=your-project-ref
SUPABASE_PROJECT_2_ANON_KEY=replace-with-banglaabhidhan-anon-key

# Alternative single-line JSON format, if you prefer one variable:
# SUPABASE_PROJECTS_JSON=[{"name":"Main workload","projectRef":"your-project-ref-1","anonKey":"your-anon-key-1"}]
