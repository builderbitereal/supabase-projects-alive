# Protects /api/keep-alive and /api/status.
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-with-a-long-random-secret

# Optional tuning.
PING_TIMEOUT_MS=15000
PING_CONCURRENCY=5
MAX_INDEXED_PROJECTS=50
SUPABASE_PING_PATH=/auth/v1/health

# Add one block per Supabase project. The REF is the project ref from:
# https://<project-ref>.supabase.co
#
# Use the anon public key from:
# Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon public
SUPABASE_PROJECT_1_NAME=Main App
SUPABASE_PROJECT_1_REF=your-project-ref-1
SUPABASE_PROJECT_1_ANON_KEY=your-anon-key-1

SUPABASE_PROJECT_2_NAME=Client App
SUPABASE_PROJECT_2_REF=your-project-ref-2
SUPABASE_PROJECT_2_ANON_KEY=your-anon-key-2

SUPABASE_PROJECT_3_NAME=Analytics App
SUPABASE_PROJECT_3_REF=your-project-ref-3
SUPABASE_PROJECT_3_ANON_KEY=your-anon-key-3

# Continue the same pattern for more projects:
# SUPABASE_PROJECT_4_NAME=Another Project
# SUPABASE_PROJECT_4_REF=your-project-ref-4
# SUPABASE_PROJECT_4_ANON_KEY=your-anon-key-4

# Alternative single-line JSON format, if you prefer one variable:
# SUPABASE_PROJECTS_JSON=[{"name":"Main App","projectRef":"your-project-ref-1","anonKey":"your-anon-key-1"}]
